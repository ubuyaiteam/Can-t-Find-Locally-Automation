 "regulatory_rules": [
  {
   "id": "in-ecig",
   "pattern": "\\b(vape|vaping|e-?cigarette|heated tobacco|hookah pen|e-?hookah)\\b",
   "status": "PROHIBITED",
   "regime": "Prohibition of Electronic Cigarettes Act, 2019",
   "authority": "MoHFW / DGFT / Customs",
   "note": "Import and sale of electronic cigarettes and similar devices is prohibited in India (verify current text).",
   "hs_hint": "8543",
   "source_urls": [
    "https://www.dgft.gov.in",
    "https://www.cbic.gov.in"
   ]
  },
  {
   "id": "in-cannabis",
   "pattern": "\\b(cbd|cannabis|hemp oil|marijuana|kratom)\\b",
   "status": "PROHIBITED",
   "regime": "NDPS Act, 1985",
   "authority": "Narcotics Control / Customs",
   "note": "Cannabis-derived and narcotic substances are controlled; treat as prohibited pending expert review.",
   "hs_hint": null,
   "source_urls": [
    "https://www.cbic.gov.in"
   ]
  },
  {
   "id": "in-jammer",
   "pattern": "\\b(signal jammer|gps jammer|radar detector|spy camera|hidden camera|stun gun|pepper spray|taser)\\b",
   "status": "PROHIBITED",
   "regime": "Telegraph / Arms / security regulations",
   "authority": "DoT / MHA / Customs",
   "note": "Jammers, covert surveillance devices and self-defence weapons are prohibited or licence-controlled.",
   "hs_hint": null,
   "source_urls": [
    "https://dot.gov.in",
    "https://www.dgft.gov.in"
   ]
  },
  {
   "id": "in-arms",
   "pattern": "\\b(airsoft|air gun|crossbow|sword|machete|ammunition|knife set|hunting knife|night vision|thermal scope)\\b",
   "status": "RESTRICTED",
   "regime": "Arms Act / DGFT restricted items",
   "authority": "MHA / DGFT",
   "note": "Weapons-type or defence-sensitive items need licences; kitchen knife sets may still need a customs ruling.",
   "hs_hint": null,
   "source_urls": [
    "https://www.dgft.gov.in"
   ]
  },
  {
   "id": "in-drone",
   "pattern": "\\b(drone|quadcopter|fpv)\\b",
   "status": "RESTRICTED",
   "regime": "Drone import policy + DGCA Drone Rules",
   "authority": "DGFT / DGCA / WPC",
   "note": "Import of drones is restricted and needs authorisation (verify current DGFT notification).",
   "hs_hint": "8806",
   "source_urls": [
    "https://www.dgft.gov.in"
   ]
  },
  {
   "id": "in-it-hw",
   "pattern": "\\b(laptop|tablet|notebook computer|all-in-one pc|ultra small form factor)\\b",
   "status": "RESTRICTED",
   "regime": "IT hardware Import Management System",
   "authority": "DGFT",
   "note": "Laptops/tablets/PCs have an import authorisation regime; check the current DGFT notification.",
   "hs_hint": "8471",
   "source_urls": [
    "https://www.dgft.gov.in"
   ]
  },
  {
   "id": "in-used",
   "pattern": "\\b(refurbished|second hand|used|pre-owned)\\b",
   "status": "RESTRICTED",
   "regime": "Import of second-hand goods",
   "authority": "DGFT",
   "note": "Second-hand goods are generally restricted.",
   "hs_hint": null,
   "source_urls": [
    "https://www.dgft.gov.in"
   ]
  },
  {
   "id": "in-wireless",
   "pattern": "\\b(bluetooth|wireless|wifi|wi-fi|walkie|router|smart speaker|earbuds|earphones|headphones|headset|smartwatch|smart watch|fitness (band|tracker)|gps tracker|video doorbell|smart camera|smart plug|smart bulb|smart lock|action camera|dash cam|webcam)\\b",
   "status": "CONDITIONAL",
   "regime": "Wireless equipment approval (ETA) / MTCTE",
   "authority": "WPC / DoT",
   "note": "Radio-emitting devices typically need ETA (WPC) and may need MTCTE certification.",
   "hs_hint": "8517 / 8518",
   "source_urls": [
    "https://saralsanchar.gov.in",
    "https://dot.gov.in"
   ]
  },
  {
   "id": "in-bis-elec",
   "pattern": "\\b(power bank|charger|adapter|adaptor|battery|led (light|lamp|strip|bulb)|smart (bulb|plug|switch)|earbuds|earphones|headphones|headset|smartwatch|smart watch|speaker|soundbar|webcam|monitor|projector|air fryer|kettle|blender|juicer|mixer|rice cooker|food processor|induction|hair dryer|hair straightener|hair curler|trimmer|shaver|toothbrush|massager|massage gun|air purifier|humidifier|fan|heater|iron|vacuum|treadmill|ice maker|waffle maker|popcorn maker|sous vide|espresso|coffee maker|desk lamp|keyboard|mouse|usb hub|ssd)\\b",
