   "hs_hint": "85xx",
   "source_urls": [
    "https://www.bis.gov.in"
   ]
  },
  {
   "id": "in-epr",
   "pattern": "\\b(battery|power bank|charger|laptop|smartwatch|smart watch|earbuds|speaker|monitor|projector|appliance|air fryer|kettle|blender)\\b",
   "status": "CONDITIONAL",
   "regime": "E-Waste (Management) Rules - EPR registration",
   "authority": "CPCB",
   "note": "Importers of covered electronics need EPR registration.",
   "hs_hint": null,
   "source_urls": [
    "https://cpcb.nic.in"
   ]
  },
  {
   "id": "in-cosmetic",
